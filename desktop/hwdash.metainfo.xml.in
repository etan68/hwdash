<?xml version="1.0" encoding="UTF-8"?>
<component type="console-application">
    <id>io.github.etan68.hwdash</id>

    <name>HWDash</name>
    <summary>Terminal CPU, memory, GPU and process monitor</summary>

    <metadata_license>CC0-1.0</metadata_license>
    <project_license>GPL-3.0-or-later</project_license>
    <developer_name>etan68 and contributors</developer_name>

    <description>
        <p>hwdash is a terminal hardware monitor based on nvtop. It combines host CPU and memory monitoring with nvtop's multi-vendor accelerator backends and process view.</p>
    </description>

    <launchable type="desktop-id">hwdash.desktop</launchable>

    <icon type="cached">hwdash.svg</icon>

    <categories>
        <category>System</category>
        <category>Monitor</category>
    </categories>

    <url type="homepage">https://github.com/etan68/hwdash</url>

    <screenshots>
        <screenshot type="default">
            <caption>The hwdash interface</caption>
            <image>https://raw.githubusercontent.com/etan68/hwdash/main/screenshot/NVTOP_ex1.png</image>
        </screenshot>
        <screenshot>
            <caption>The hwdash option screen</caption>
            <image>https://raw.githubusercontent.com/etan68/hwdash/main/screenshot/Nvtop-config.png</image>
        </screenshot>
    </screenshots>

    <provides>
        <binary>hwdash</binary>
    </provides>
    <releases>
    <release version="@nvtop_VERSION_MAJOR@.@nvtop_VERSION_MINOR@.@nvtop_VERSION_PATCH@" date="@TODAY_ISO_8601@"></release>
    </releases>
</component>
