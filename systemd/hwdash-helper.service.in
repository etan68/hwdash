[Unit]
Description=Publish privileged hardware metrics for HWDash

[Service]
Type=simple
ExecStart=@CMAKE_INSTALL_FULL_LIBEXECDIR@/hwdash-helper
RuntimeDirectory=hwdash
RuntimeDirectoryMode=0755
Restart=on-failure
RestartSec=2s
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/run/hwdash

[Install]
WantedBy=multi-user.target
