[Unit]
Description=Publish Lenovo CPU fan RPM for hwdash
After=systemd-modules-load.service

[Service]
Type=simple
ExecStartPre=/usr/sbin/modprobe ec_sys
ExecStart=@CMAKE_INSTALL_FULL_LIBEXECDIR@/hwdash-lenovo-cpu-fan-helper
RuntimeDirectory=hwdash
RuntimeDirectoryMode=0755
Restart=on-failure
RestartSec=2s
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/run/hwdash

[Install]
WantedBy=multi-user.target
